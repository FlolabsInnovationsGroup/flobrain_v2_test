# Sovereign "open models only" profile. Copy to .env and fill in. Never commit .env.
# Values marked CHANGE must be set; the rest are the profile defaults.

# --- Django ---
SECRET_KEY=CHANGE-64-random-characters
AES_MASTER_KEY=CHANGE-64-hex-characters
CREDENTIALS_ENCRYPTION_KEY=CHANGE-64-hex-characters
DEBUG=False
ALLOWED_HOSTS=flobrain.internal.example
CORS_ALLOWED_ORIGINS=https://flobrain.internal.example
FRONTEND_BASE_URL=https://flobrain.internal.example
PUBLIC_API_BASE_URL=https://api.flobrain.internal.example

# --- Database (pgvector) ---
DB_ENGINE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=flobrain_db
DB_USER=flo_user
DB_PASS=CHANGE-strong-password

# --- Models: self-hosted only ---
AI_PROVIDER_BACKEND=direct
AI_DIRECT_BASE_URL=http://vllm:8000/v1
AI_DIRECT_API_KEY=CHANGE-same-value-as-VLLM_API_KEY
AI_DIRECT_MODEL_ALLOWLIST=CHANGE-served-model-name
AI_DIRECT_DEFAULT_MODEL=CHANGE-served-model-name
AI_DIRECT_PROVIDER=self_hosted
EMBEDDINGS_BACKEND=http
EMBEDDINGS_BASE_URL=http://embeddings:80/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMENSION=1024
KNOWLEDGE_VECTOR_STORE=pgvector
# Only these hosts count as private, and only they may be called over plain http inside the cluster.
AI_SELF_HOSTED_HOSTS=vllm,embeddings
AI_ALLOW_PLAINTEXT_HOSTS=vllm,embeddings
# Every org is private_only and cannot switch back. V1 chat is refused too (it would use the multimodal host).
AI_FORCE_PRIVATE_ONLY=True
# Empty on purpose: the hosted multimodal service is never used here.
MULTIMODAL_SERVICE_URL=
# Customer keys may only point at the in-cluster model.
BYOK_ALLOWED_HOSTS=vllm

# --- Jobs ---
JOBS_EAGER=False
JOBS_WORKER_ENABLED=True

# --- Storage (exports, Content Studio): S3-compatible bucket inside the perimeter, or leave empty ---
CONTENT_STORAGE=
CONTENT_S3_BUCKET=
CONTENT_S3_REGION=

# --- Model servers ---
VLLM_IMAGE=CHANGE-pinned-vllm-openai-image@sha256:...
VLLM_MODEL=CHANGE-hf-model-id
VLLM_SERVED_NAME=CHANGE-served-model-name
VLLM_API_KEY=CHANGE-random
TEI_IMAGE=CHANGE-pinned-text-embeddings-inference-image@sha256:...
